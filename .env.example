# ─── Backend Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values.

# ── Node ─────────────────────────────────────────────────────────────
# Purpose:  Controls logging verbosity and error detail.
# Values:   development | test | production
# Free:     N/A (built-in)
NODE_ENV=development

# ── Server ───────────────────────────────────────────────────────────
# Purpose:  Which port the Express server listens on.
# Format:   Integer (1024–65535)
# Free:     N/A
PORT=4000

# ── Database ─────────────────────────────────────────────────────────
# Purpose:  PostgreSQL connection string used by Prisma.
# Format:   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Where:    Create a free PostgreSQL instance at:
#           • Supabase    — https://supabase.com (free tier)
#           • Neon        — https://neon.tech (free tier)
#           • Railway     — https://railway.app (free tier with limits)
#           • Local       — Install PostgreSQL locally
# Free:     Yes (all above providers have free tiers)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/folio?schema=public"

# ── Authentication ───────────────────────────────────────────────────
# Purpose:  Secret key for signing JWT tokens. Must be at least 32 chars.
# Format:   Any long random string (use: openssl rand -base64 48)
# Where:    Generate it yourself — never reuse or share it.
# Free:     N/A (self-generated)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Purpose:  How long JWT tokens remain valid.
# Format:   Vercel/jsonwebtoken duration string (e.g. "7d", "24h", "30m")
# Free:     N/A
JWT_EXPIRES_IN="7d"

# ── CORS ─────────────────────────────────────────────────────────────
# Purpose:  Allowed frontend origin(s) for cross-origin requests.
# Format:   Comma-separated URLs (no trailing slash)
# Free:     N/A
CORS_ORIGIN="http://localhost:5173"

# ── Market Data ──────────────────────────────────────────────────────
# Purpose:  Which price provider the MarketDataService uses.
# Values:   stub | alphavantage | polygon | twelvedata
# Free:     "stub" works without any API key (uses hardcoded prices).
MARKET_DATA_PROVIDER="stub"

# Purpose:  API key for the chosen market data provider.
# Where:    • Alpha Vantage — https://www.alphavantage.co/support/#api-key (free)
#           • Polygon.io    — https://polygon.io (free tier)
#           • Twelve Data   — https://twelvedata.com (free tier)
# Free:     Yes (all above have free tiers with rate limits)
MARKET_DATA_API_KEY=""

# ── Email (Resend) — signup verification codes ───────────────────────
# Purpose:  Sends the 6-digit code emailed during sign-up.
# Where:    https://resend.com → API Keys → Create API Key
# Free:     Yes (3,000 emails/month, 100/day). Without this key, codes are
#           printed to the server console in development (and sign-up is
#           refused when NODE_ENV=production).
RESEND_API_KEY=""

# Purpose:  The "From" address on those emails.
# Format:   Name <address@your-verified-domain.com>
# Note:     "Folio <onboarding@resend.dev>" works for testing but Resend only
#           delivers it to the email address you signed up to Resend with.
#           To email real users, verify your own domain at https://resend.com/domains
#           and use an address on it.
EMAIL_FROM="Folio <onboarding@resend.dev>"
